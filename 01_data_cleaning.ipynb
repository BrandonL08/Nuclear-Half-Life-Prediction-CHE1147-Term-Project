    "#1. Load and inspect the ENSDF-derived dataset\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.read_csv(\"ensdf_ground_state_candidates.csv\")\n",
    "\n",
    "print(\"Dataset shape:\", df.shape)\n",
    "display(df.head())"
   ]
  },
